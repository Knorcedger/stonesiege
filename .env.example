# Copy to .env.local (git-ignored) and fill in. Every variable is optional:
# StoneSiege is offline-first and runs identically with none of them set.

# First-party endpoint for anonymous gameplay statistics. Leave empty to
# disable measurement entirely — no request is made and no session identifier
# is created. Dev builds never report, even when this is set, so a playtest
# cannot pollute production data.
VITE_ANALYTICS_ENDPOINT=
