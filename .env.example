# Copy to .env.local (git-ignored) and fill in. Every variable is optional:
# StoneSiege is offline-first and runs identically with none of them set.

# Google Analytics 4 measurement id for anonymous, cookieless gameplay
# statistics. Leave empty to disable measurement entirely — no gtag script is
# requested and no session identifier is created. Dev builds never report, even
# when this is set, so a playtest cannot pollute the property.
VITE_GA_ID=
