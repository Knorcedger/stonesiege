* text=auto

*.md text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.ts text diff eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.zsh text eol=lf

*.aab binary
*.aiff binary
*.apk binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.keystore binary
*.m4a binary
*.p12 binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
art/**/*.png filter=lfs diff=lfs merge=lfs -text
art/**/*.jpg filter=lfs diff=lfs merge=lfs -text
art/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
store/screenshots/**/*.png filter=lfs diff=lfs merge=lfs -text
store/screenshots/**/*.jpg filter=lfs diff=lfs merge=lfs -text
store/screenshots/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
