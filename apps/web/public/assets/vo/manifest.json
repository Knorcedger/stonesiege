{
  "version": 1,
  "voices": {
    "Narrator": "Daniel",
    "Wallace": "Daniel",
    "Douglas": "Daniel",
    "Moray": "Daniel",
    "Cressingham": "Daniel",
    "Warenne": "Daniel",
    "Graham": "Daniel",
    "Fraser": "Daniel"
  },
  "lines": {
    "19116996": {
      "file": "wallace-19116996.m4a",
      "ms": 1340,
      "text": "I want eyes on the ford.",
      "speaker": "Wallace"
    },
    "19885822": {
      "file": "graham-19885822.m4a",
      "ms": 1059,
      "text": "look at the field.",
      "speaker": "Graham"
    },
    "34043998": {
      "file": "wallace-34043998.m4a",
      "ms": 479,
      "text": "John!",
      "speaker": "Wallace"
    },
    "37237966": {
      "file": "narrator-37237966.m4a",
      "ms": 2022,
      "text": "A grievance becomes a rebellion.",
      "speaker": "Narrator"
    },
    "53319595": {
      "file": "wallace-53319595.m4a",
      "ms": 1719,
      "text": "kin are coming in from the hills.",
      "speaker": "Wallace"
    },
    "67680367": {
      "file": "moray-67680367.m4a",
      "ms": 2430,
      "text": "A blade in the water drowns same as a coward.",
      "speaker": "Moray"
    },
    "77449753": {
      "file": "douglas-77449753.m4a",
      "ms": 2859,
      "text": "before the justiciar finds a faster horse.",
      "speaker": "Douglas"
    },
    "78717792": {
      "file": "narrator-78717792.m4a",
      "ms": 4402,
      "text": "After Earnside, the military record of William Wallace falls silent.",
      "speaker": "Narrator"
    },
    "84885228": {
      "file": "wallace-84885228.m4a",
      "ms": 2496,
      "text": "Then tomorrow the sheriff answers his own ledger.",
      "speaker": "Wallace"
    },
    "00670982": {
      "file": "graham-00670982.m4a",
      "ms": 697,
      "text": "SCHILTRON!",
      "speaker": "Graham"
    },
    "0340b209": {
      "file": "moray-0340b209.m4a",
      "ms": 2116,
      "text": "not one of them recrosses that bridge!",
      "speaker": "Moray"
    },
    "058ecd41": {
      "file": "narrator-058ecd41.m4a",
      "ms": 2776,
      "text": "But Andrew Moray took his wounds on the causeway.",
      "speaker": "Narrator"
    },
    "07a3e2b9": {
      "file": "narrator-07a3e2b9.m4a",
      "ms": 1488,
      "text": "Ormesby flees south.",
      "speaker": "Narrator"
    },
    "0858c14a": {
      "file": "narrator-0858c14a.m4a",
      "ms": 2629,
      "text": "Keep them behind the line, never in it.",
      "speaker": "Narrator"
    },
    "085a9021": {
      "file": "douglas-085a9021.m4a",
      "ms": 1756,
      "text": "Ormesby is packing his silver.",
      "speaker": "Douglas"
    },
    "086eedaf": {
      "file": "narrator-086eedaf.m4a",
      "ms": 1251,
      "text": "Heselrig is dead.",
      "speaker": "Narrator"
    },
    "09bfba3b": {
      "file": "douglas-09bfba3b.m4a",
      "ms": 967,
      "text": "Across the ford",
      "speaker": "Douglas"
    },
    "0abbb025": {
      "file": "narrator-0abbb025.m4a",
      "ms": 2460,
      "text": "The men remember every fine he levied",
      "speaker": "Narrator"
    },
    "0be69e83": {
      "file": "narrator-0be69e83.m4a",
      "ms": 1796,
      "text": "The crowning-place of kings",
      "speaker": "Narrator"
    },
    "0cb99b5a": {
      "file": "douglas-0cb99b5a.m4a",
      "ms": 1501,
      "text": "A camp worth defending.",
      "speaker": "Douglas"
    },
    "0d0c71f5": {
      "file": "narrator-0d0c71f5.m4a",
      "ms": 5076,
      "text": "In the north, Andrew Moray’s separate rising is sweeping English garrisons away.",
      "speaker": "Narrator"
    },
    "0d10b171": {
      "file": "wallace-0d10b171.m4a",
      "ms": 2253,
      "text": "Spear hafts, roof beams",
      "speaker": "Wallace"
    },
    "0f79f7ad": {
      "file": "wallace-0f79f7ad.m4a",
      "ms": 2835,
      "text": "What is left of the host is being whipped up the causeway",
      "speaker": "Wallace"
    },
    "10d3ddbe": {
      "file": "narrator-10d3ddbe.m4a",
      "ms": 3043,
      "text": "Monks heal the hurt and turn the enemy's own steel.",
      "speaker": "Narrator"
    },
    "10f93e2b": {
      "file": "narrator-10f93e2b.m4a",
      "ms": 2518,
      "text": "The west road belongs to the Forest now.",
      "speaker": "Narrator"
    },
    "1243bc6c": {
      "file": "wallace-1243bc6c.m4a",
      "ms": 1836,
      "text": "Call the kin down from the hills.",
      "speaker": "Wallace"
    },
    "12f3597a": {
      "file": "douglas-12f3597a.m4a",
      "ms": 629,
      "text": "Wallace!",
      "speaker": "Douglas"
    },
    "1341f97b": {
      "file": "douglas-1341f97b.m4a",
      "ms": 1419,
      "text": "Douglas rides with you.",
      "speaker": "Douglas"
    },
    "13a69f03": {
      "file": "wallace-13a69f03.m4a",
      "ms": 908,
      "text": "Now roofs",
      "speaker": "Wallace"
    },
    "16d6c17f": {
      "file": "fraser-16d6c17f.m4a",
      "ms": 2053,
      "text": "The pen at Happrew holds only the dead.",
      "speaker": "Fraser"
    },
    "1a3d5e59": {
      "file": "wallace-1a3d5e59.m4a",
      "ms": 1280,
      "text": "you're Scotland's again.",
      "speaker": "Wallace"
    },
    "1a9ad617": {
      "file": "narrator-1a9ad617.m4a",
      "ms": 3028,
      "text": "Heselrig sits in judgement at Lanark tomorrow.",
      "speaker": "Narrator"
    },
    "1b0cd374": {
      "file": "fraser-1b0cd374.m4a",
      "ms": 2227,
      "text": "Earnside's tower holds the only bridge.",
      "speaker": "Fraser"
    },
    "1fa47851": {
      "file": "narrator-1fa47851.m4a",
      "ms": 2307,
      "text": "Farms under frost still feed men",
      "speaker": "Narrator"
    },
    "208d8a64": {
      "file": "cressingham-208d8a64.m4a",
      "ms": 2731,
      "text": "Riders, cross, in the king's name",
      "speaker": "Cressingham"
    },
    "20f54518": {
      "file": "narrator-20f54518.m4a",
      "ms": 2219,
      "text": "war is a guest that eats everything.",
      "speaker": "Narrator"
    },
    "219774ad": {
      "file": "wallace-219774ad.m4a",
      "ms": 862,
      "text": "Moray is hit",
      "speaker": "Wallace"
    },
    "21ec4981": {
      "file": "narrator-21ec4981.m4a",
      "ms": 2472,
      "text": "The full weight of England leans on the line.",
      "speaker": "Narrator"
    },
    "249678d3": {
      "file": "wallace-249678d3.m4a",
      "ms": 2636,
      "text": "hold the bridgehead and let the Forth take the rest.",
      "speaker": "Wallace"
    },
    "2691a061": {
      "file": "narrator-2691a061.m4a",
      "ms": 2939,
      "text": "Lanark, May 1297.",
      "speaker": "Narrator"
    },
    "2801273a": {
      "file": "wallace-2801273a.m4a",
      "ms": 1045,
      "text": "The stores burn.",
      "speaker": "Wallace"
    },
    "291934ea": {
      "file": "narrator-291934ea.m4a",
      "ms": 4237,
      "text": "The wagons roll north, heavy with the Tyne valley's winter stores.",
      "speaker": "Narrator"
    },
    "298d08d6": {
      "file": "fraser-298d08d6.m4a",
      "ms": 1988,
      "text": "Break the wall and they're ours again.",
      "speaker": "Fraser"
    },
    "2e59523c": {
      "file": "graham-2e59523c.m4a",
      "ms": 1359,
      "text": "The castle is breached",
      "speaker": "Graham"
    },
    "30c7f206": {
      "file": "narrator-30c7f206.m4a",
      "ms": 1648,
      "text": "The watch-fort burns.",
      "speaker": "Narrator"
    },
    "325f5c8d": {
      "file": "narrator-325f5c8d.m4a",
      "ms": 1023,
      "text": "Word comes:",
      "speaker": "Narrator"
    },
    "32ae46e8": {
      "file": "narrator-32ae46e8.m4a",
      "ms": 2092,
      "text": "Knights round the western flank!",
      "speaker": "Narrator"
    },
    "36e3a032": {
      "file": "wallace-36e3a032.m4a",
      "ms": 3809,
      "text": "Strike fast, and leave before the garrison closes its fist.",
      "speaker": "Wallace"
    },
    "36fede04": {
      "file": "narrator-36fede04.m4a",
      "ms": 1369,
      "text": "The warning fails.",
      "speaker": "Narrator"
    },
    "371aa895": {
      "file": "warenne-371aa895.m4a",
      "ms": 1047,
      "text": "We are done here.",
      "speaker": "Warenne"
    },
    "37f19f77": {
      "file": "wallace-37f19f77.m4a",
      "ms": 2555,
      "text": "Smoke rises where I say it rises now.",
      "speaker": "Wallace"
    },
    "39aa817e": {
      "file": "narrator-39aa817e.m4a",
      "ms": 1294,
      "text": "Cressingham is down.",
      "speaker": "Narrator"
    },
    "3bc5fe40": {
      "file": "narrator-3bc5fe40.m4a",
      "ms": 1424,
      "text": "Falkirk is lost.",
      "speaker": "Narrator"
    },
    "3ce972d1": {
      "file": "wallace-3ce972d1.m4a",
      "ms": 665,
      "text": "Settled.",
      "speaker": "Wallace"
    },
    "3cf4bfa1": {
      "file": "graham-3cf4bfa1.m4a",
      "ms": 525,
      "text": "Bowmen",
      "speaker": "Graham"
    },
    "3dcd1818": {
      "file": "graham-3dcd1818.m4a",
      "ms": 2998,
      "text": "Now we discover who keeps faith when the arrows fall.",
      "speaker": "Graham"
    },
    "4000124e": {
      "file": "wallace-4000124e.m4a",
      "ms": 1202,
      "text": "I gave them my word.",
      "speaker": "Wallace"
    },
    "404af76b": {
      "file": "wallace-404af76b.m4a",
      "ms": 711,
      "text": "Not yet",
      "speaker": "Wallace"
    },
    "416ec4b5": {
      "file": "moray-416ec4b5.m4a",
      "ms": 1260,
      "text": "NOW, Wallace!",
      "speaker": "Moray"
    },
    "41bd2cfb": {
      "file": "narrator-41bd2cfb.m4a",
      "ms": 1592,
      "text": "Night falls over the glen.",
      "speaker": "Narrator"
    },
    "42b11a14": {
      "file": "wallace-42b11a14.m4a",
      "ms": 3590,
      "text": "When every pardoned sword in Scotland was sheathed, his was out",
      "speaker": "Wallace"
    },
    "432184dc": {
      "file": "wallace-432184dc.m4a",
      "ms": 1162,
      "text": "Heselrig's tower.",
      "speaker": "Wallace"
    },
    "46b0ee53": {
      "file": "narrator-46b0ee53.m4a",
      "ms": 4925,
      "text": "Across Scotland, men look at their own garrisons and begin to count spears.",
      "speaker": "Narrator"
    },
    "47bdf303": {
      "file": "douglas-47bdf303.m4a",
      "ms": 1010,
      "text": "The road is open.",
      "speaker": "Douglas"
    },
    "489105c9": {
      "file": "narrator-489105c9.m4a",
      "ms": 4710,
      "text": "Farther south, Corbridge and Hexham still provision English garrisons.",
      "speaker": "Narrator"
    },
    "4908939d": {
      "file": "narrator-4908939d.m4a",
      "ms": 6050,
      "text": "Within weeks, Wallace resigns the Guardianship into the hands of the nobles who watched from the treeline.",
      "speaker": "Narrator"
    },
    "4a08096e": {
      "file": "fraser-4a08096e.m4a",
      "ms": 2894,
      "text": "Every unpardoned man in the south is here, Will.",
      "speaker": "Fraser"
    },
    "4a1e0c04": {
      "file": "graham-4a1e0c04.m4a",
      "ms": 1359,
      "text": "the camp cannot hold!",
      "speaker": "Graham"
    },
    "4b4751d2": {
      "file": "graham-4b4751d2.m4a",
      "ms": 863,
      "text": "THOUSANDS.",
      "speaker": "Graham"
    },
    "4b836532": {
      "file": "wallace-4b836532.m4a",
      "ms": 2799,
      "text": "Scotland needs living men more than dead heroes.",
      "speaker": "Wallace"
    },
    "4bd1fb2c": {
      "file": "narrator-4bd1fb2c.m4a",
      "ms": 4274,
      "text": "Before the first snow, the best soldier of the rising will be gone",
      "speaker": "Narrator"
    },
    "4c32b47c": {
      "file": "narrator-4c32b47c.m4a",
      "ms": 1619,
      "text": "Corbridge's keep is rubble.",
      "speaker": "Narrator"
    },
    "51c56240": {
      "file": "graham-51c56240.m4a",
      "ms": 2220,
      "text": "Dig in, my lord Guardian-to-be.",
      "speaker": "Graham"
    },
    "53af8553": {
      "file": "narrator-53af8553.m4a",
      "ms": 4585,
      "text": "Stirling Bridge, 11 September 1297.",
      "speaker": "Narrator"
    },
    "556f4399": {
      "file": "cressingham-556f4399.m4a",
      "ms": 3358,
      "text": "wages are owed for VICTORIES, not for standing about.",
      "speaker": "Cressingham"
    },
    "55a0e00d": {
      "file": "wallace-55a0e00d.m4a",
      "ms": 328,
      "text": "Good.",
      "speaker": "Wallace"
    },
    "564990cd": {
      "file": "cressingham-564990cd.m4a",
      "ms": 909,
      "text": "Enough delay!",
      "speaker": "Cressingham"
    },
    "59059c42": {
      "file": "douglas-59059c42.m4a",
      "ms": 1825,
      "text": "But my men eat like horses",
      "speaker": "Douglas"
    },
    "5a9b84cf": {
      "file": "graham-5a9b84cf.m4a",
      "ms": 1905,
      "text": "Snow hides our tracks and theirs.",
      "speaker": "Graham"
    },
    "5ab56384": {
      "file": "wallace-5ab56384.m4a",
      "ms": 1872,
      "text": "Lanark, beyond the river bend.",
      "speaker": "Wallace"
    },
    "5ad9f0f8": {
      "file": "wallace-5ad9f0f8.m4a",
      "ms": 1263,
      "text": "The priory does NOT.",
      "speaker": "Wallace"
    },
    "5ae5b97a": {
      "file": "narrator-5ae5b97a.m4a",
      "ms": 2185,
      "text": "New soldiers, new tools",
      "speaker": "Narrator"
    },
    "5b6a4880": {
      "file": "narrator-5b6a4880.m4a",
      "ms": 4809,
      "text": "On the wing where the lords' cavalry should stand, there is only wind in the trees.",
      "speaker": "Narrator"
    },
    "5b7bd30c": {
      "file": "fraser-5b7bd30c.m4a",
      "ms": 2533,
      "text": "While they stand, Bothwell sleeps easy.",
      "speaker": "Fraser"
    },
    "5bb12960": {
      "file": "narrator-5bb12960.m4a",
      "ms": 2225,
      "text": "The English think Scotland is settled.",
      "speaker": "Narrator"
    },
    "5d2f7b49": {
      "file": "wallace-5d2f7b49.m4a",
      "ms": 1491,
      "text": "I have brought you to the ring.",
      "speaker": "Wallace"
    },
    "5d9fb2a0": {
      "file": "narrator-5d9fb2a0.m4a",
      "ms": 2533,
      "text": "Edward of England has crossed his last river.",
      "speaker": "Narrator"
    },
    "60b2fd03": {
      "file": "wallace-60b2fd03.m4a",
      "ms": 1080,
      "text": "Sound the retreat",
      "speaker": "Wallace"
    },
    "61acb3de": {
      "file": "narrator-61acb3de.m4a",
      "ms": 5157,
      "text": "at Bannockburn in 1314, the road from Lanark reaches a free Scotland.",
      "speaker": "Narrator"
    },
    "62444b5d": {
      "file": "narrator-62444b5d.m4a",
      "ms": 3856,
      "text": "Build a Lumber Camp beside the western wood so the walk is short.",
      "speaker": "Narrator"
    },
    "62f03aff": {
      "file": "wallace-62f03aff.m4a",
      "ms": 443,
      "text": "No.",
      "speaker": "Wallace"
    },
    "664eb498": {
      "file": "wallace-664eb498.m4a",
      "ms": 3929,
      "text": "Any man who forgets that answers to me, and I have had a long winter.",
      "speaker": "Wallace"
    },
    "670ba0a3": {
      "file": "narrator-670ba0a3.m4a",
      "ms": 2127,
      "text": "a small mercy of the game of war.",
      "speaker": "Narrator"
    },
    "6eb5dbd0": {
      "file": "narrator-6eb5dbd0.m4a",
      "ms": 1454,
      "text": "and one promise to keep.",
      "speaker": "Narrator"
    },
    "6f726d17": {
      "file": "wallace-6f726d17.m4a",
      "ms": 4344,
      "text": "whatever peace they write for him after, the Forest remembers whose side he held.",
      "speaker": "Wallace"
    },
    "721d2f64": {
      "file": "wallace-721d2f64.m4a",
      "ms": 2137,
      "text": "Scotland, what a price you ask.",
      "speaker": "Wallace"
    },
    "72eb26ea": {
      "file": "wallace-72eb26ea.m4a",
      "ms": 514,
      "text": "Enough.",
      "speaker": "Wallace"
    },
    "7437ac3c": {
      "file": "graham-7437ac3c.m4a",
      "ms": 1161,
      "text": "Their engines burn!",
      "speaker": "Graham"
    },
    "750d0c56": {
      "file": "narrator-750d0c56.m4a",
      "ms": 1570,
      "text": "It goes into the hills",
      "speaker": "Narrator"
    },
    "7598c232": {
      "file": "narrator-7598c232.m4a",
      "ms": 1346,
      "text": "The man could be killed.",
      "speaker": "Narrator"
    },
    "77b98644": {
      "file": "fraser-77b98644.m4a",
      "ms": 2223,
      "text": "Happrew's fort watches the west road;",
      "speaker": "Fraser"
    },
    "7ac8eb4e": {
      "file": "wallace-7ac8eb4e.m4a",
      "ms": 1823,
      "text": "the way a boot settles on a neck.",
      "speaker": "Wallace"
    },
    "7b5b8bda": {
      "file": "graham-7b5b8bda.m4a",
      "ms": 1210,
      "text": "Get the Guardian OUT!",
      "speaker": "Graham"
    },
    "7fa24507": {
      "file": "moray-7fa24507.m4a",
      "ms": 2159,
      "text": "they mean to take your camp from behind!",
      "speaker": "Moray"
    },
    "811cdb49": {
      "file": "narrator-811cdb49.m4a",
      "ms": 3504,
      "text": "Here the record catches Wallace in arms for the last time.",
      "speaker": "Narrator"
    },
    "82fd56b7": {
      "file": "narrator-82fd56b7.m4a",
      "ms": 1264,
      "text": "The rising could not.",
      "speaker": "Narrator"
    },
    "866373d4": {
      "file": "fraser-866373d4.m4a",
      "ms": 1379,
      "text": "Feed them, arm them",
      "speaker": "Fraser"
    },
    "87d4a5a7": {
      "file": "narrator-87d4a5a7.m4a",
      "ms": 2983,
      "text": "Segrave's riders sweep the Forest roads again.",
      "speaker": "Narrator"
    },
    "87d635a2": {
      "file": "narrator-87d635a2.m4a",
      "ms": 7522,
      "text": "The first army of knights ever broken by common footmen streams south, and Scotland north of the Forth is free ground.",
      "speaker": "Narrator"
    },
    "87f5814c": {
      "file": "wallace-87f5814c.m4a",
      "ms": 1382,
      "text": "Carry Sir Simon back.",
      "speaker": "Wallace"
    },
    "88b4e101": {
      "file": "graham-88b4e101.m4a",
      "ms": 2186,
      "text": "and the lords who swore us THEIR horses.",
      "speaker": "Graham"
    },
    "8a5b339a": {
      "file": "narrator-8a5b339a.m4a",
      "ms": 1930,
      "text": "and new attention from the enemy.",
      "speaker": "Narrator"
    },
    "8afeaec4": {
      "file": "narrator-8afeaec4.m4a",
      "ms": 2533,
      "text": "Official ink says Scotland is at peace.",
      "speaker": "Narrator"
    },
    "8c015883": {
      "file": "moray-8c015883.m4a",
      "ms": 511,
      "text": "Steady.",
      "speaker": "Moray"
    },
    "8c559479": {
      "file": "wallace-8c559479.m4a",
      "ms": 2584,
      "text": "north, through the wood, and DO NOT STOP.",
      "speaker": "Wallace"
    },
    "8d804fd7": {
      "file": "wallace-8d804fd7.m4a",
      "ms": 965,
      "text": "carry him back!",
      "speaker": "Wallace"
    },
    "8fb48454": {
      "file": "narrator-8fb48454.m4a",
      "ms": 3195,
      "text": "In Westminster Hall he rejects the charge of treason:",
      "speaker": "Narrator"
    },
    "9006ed30": {
      "file": "narrator-9006ed30.m4a",
      "ms": 2314,
      "text": "Houses raise your population room.",
      "speaker": "Narrator"
    },
    "90536af9": {
      "file": "narrator-90536af9.m4a",
      "ms": 1230,
      "text": "The camp will hold.",
      "speaker": "Narrator"
    },
    "9183625e": {
      "file": "narrator-9183625e.m4a",
      "ms": 3137,
      "text": "Knights on the causeway, footmen at their heels.",
      "speaker": "Narrator"
    },
    "92620ca9": {
      "file": "wallace-92620ca9.m4a",
      "ms": 2482,
      "text": "The flock's scattered since the soldiers came.",
      "speaker": "Wallace"
    },
    "93e3daa1": {
      "file": "warenne-93e3daa1.m4a",
      "ms": 560,
      "text": "BURN IT.",
      "speaker": "Warenne"
    },
    "94ad2bb0": {
      "file": "wallace-94ad2bb0.m4a",
      "ms": 758,
      "text": "On your feet",
      "speaker": "Wallace"
    },
    "95bf3410": {
      "file": "narrator-95bf3410.m4a",
      "ms": 9255,
      "text": "On 23 August he is executed at Smithfield and his quartered body sent to Newcastle, Berwick, Stirling, and Perth as a warning.",
      "speaker": "Narrator"
    },
    "95f118e5": {
      "file": "narrator-95f118e5.m4a",
      "ms": 1134,
      "text": "form your line.",
      "speaker": "Narrator"
    },
    "9675f96d": {
      "file": "graham-9675f96d.m4a",
      "ms": 1615,
      "text": "Sell what we cannot carry",
      "speaker": "Graham"
    },
    "96f29800": {
      "file": "narrator-96f29800.m4a",
      "ms": 1770,
      "text": "Cressingham orders the crossing.",
      "speaker": "Narrator"
    },
    "97391e5f": {
      "file": "narrator-97391e5f.m4a",
      "ms": 4668,
      "text": "Wallace burns Stirling and Perth behind him so that Edward may govern ashes.",
      "speaker": "Narrator"
    },
    "986371b6": {
      "file": "narrator-986371b6.m4a",
      "ms": 3358,
      "text": "An army that cannot be fed at home must be fed abroad.",
      "speaker": "Narrator"
    },
    "98c5af74": {
      "file": "narrator-98c5af74.m4a",
      "ms": 4831,
      "text": "Behind them, Northumberland learns what Scotland has known for two years:",
      "speaker": "Narrator"
    },
    "9a718674": {
      "file": "narrator-9a718674.m4a",
      "ms": 2806,
      "text": "The Earl of Surrey did not stay to test the ford.",
      "speaker": "Narrator"
    },
    "9b4c8f19": {
      "file": "wallace-9b4c8f19.m4a",
      "ms": 961,
      "text": "Full bellies.",
      "speaker": "Wallace"
    },
    "9c2a1fac": {
      "file": "douglas-9c2a1fac.m4a",
      "ms": 1767,
      "text": "build us a camp worth the name.",
      "speaker": "Douglas"
    },
    "9d2ba4f8": {
      "file": "narrator-9d2ba4f8.m4a",
      "ms": 1404,
      "text": "The war does not end.",
      "speaker": "Narrator"
    },
    "a101d6a8": {
      "file": "narrator-a101d6a8.m4a",
      "ms": 1848,
      "text": "Reseed them when they exhaust.",
      "speaker": "Narrator"
    },
    "a250c40b": {
      "file": "cressingham-a250c40b.m4a",
      "ms": 3326,
      "text": "I shall recover the cost of this war from their hides personally.",
      "speaker": "Cressingham"
    },
    "a260b967": {
      "file": "graham-a260b967.m4a",
      "ms": 2290,
      "text": "and the priory stands on Wallace’s word.",
      "speaker": "Graham"
    },
    "a55e0f7f": {
      "file": "narrator-a55e0f7f.m4a",
      "ms": 2231,
      "text": "and Wallace will carry the war alone.",
      "speaker": "Narrator"
    },
    "a6a870e0": {
      "file": "narrator-a6a870e0.m4a",
      "ms": 3772,
      "text": "Scone, summer 1297.",
      "speaker": "Narrator"
    },
    "a8814818": {
      "file": "narrator-a8814818.m4a",
      "ms": 3066,
      "text": "Bothwell on the Clyde, seat of Edward's Warden.",
      "speaker": "Narrator"
    },
    "a8e7a335": {
      "file": "wallace-a8e7a335.m4a",
      "ms": 2278,
      "text": "Let the Warden's clerks write THAT down.",
      "speaker": "Wallace"
    },
    "a999e31f": {
      "file": "narrator-a999e31f.m4a",
      "ms": 1102,
      "text": "The Feudal Age.",
      "speaker": "Narrator"
    },
    "ab820fd1": {
      "file": "moray-ab820fd1.m4a",
      "ms": 1582,
      "text": "Riders at the western ford",
      "speaker": "Moray"
    },
    "acfea737": {
      "file": "narrator-acfea737.m4a",
      "ms": 2785,
      "text": "The camp is fed, roofed, and hidden.",
      "speaker": "Narrator"
    },
    "ad7eb62f": {
      "file": "narrator-ad7eb62f.m4a",
      "ms": 2324,
      "text": "now the counting-house of the justiciar.",
      "speaker": "Narrator"
    },
    "add20fe3": {
      "file": "wallace-add20fe3.m4a",
      "ms": 1741,
      "text": "Heselrig, not the town.",
      "speaker": "Wallace"
    },
    "b01730a4": {
      "file": "graham-b01730a4.m4a",
      "ms": 2459,
      "text": "This valley will provision Scotland for a year.",
      "speaker": "Graham"
    },
    "b069cf9b": {
      "file": "fraser-b069cf9b.m4a",
      "ms": 1166,
      "text": "Happrew burns.",
      "speaker": "Fraser"
    },
    "b2183405": {
      "file": "narrator-b2183405.m4a",
      "ms": 1395,
      "text": "and so does Wallace.",
      "speaker": "Narrator"
    },
    "b27c7dd8": {
      "file": "graham-b27c7dd8.m4a",
      "ms": 641,
      "text": "But Will",
      "speaker": "Graham"
    },
    "b293cc61": {
      "file": "fraser-b293cc61.m4a",
      "ms": 2125,
      "text": "They keep our people penned in that fort",
      "speaker": "Fraser"
    },
    "b2aaf242": {
      "file": "narrator-b2aaf242.m4a",
      "ms": 1752,
      "text": "Soon the two armies will meet.",
      "speaker": "Narrator"
    },
    "b2dd94ff": {
      "file": "narrator-b2dd94ff.m4a",
      "ms": 1939,
      "text": "Plunder is heavy and gold is not.",
      "speaker": "Narrator"
    },
    "b455abc8": {
      "file": "narrator-b455abc8.m4a",
      "ms": 2864,
      "text": "Farms are slower than berries but never run out.",
      "speaker": "Narrator"
    },
    "b5764f98": {
      "file": "narrator-b5764f98.m4a",
      "ms": 2318,
      "text": "Food is dropped off at the Town Center.",
      "speaker": "Narrator"
    },
    "b592bc09": {
      "file": "narrator-b592bc09.m4a",
      "ms": 7351,
      "text": "In the spring, at the Forest Kirk, the community of the realm names William Wallace knight and sole Guardian of Scotland",
      "speaker": "Narrator"
    },
    "b650e658": {
      "file": "wallace-b650e658.m4a",
      "ms": 499,
      "text": "So.",
      "speaker": "Wallace"
    },
    "b8ed0d64": {
      "file": "narrator-b8ed0d64.m4a",
      "ms": 1912,
      "text": "The camp will hold through the snow.",
      "speaker": "Narrator"
    },
    "ba03a7e2": {
      "file": "fraser-ba03a7e2.m4a",
      "ms": 1605,
      "text": "and give them somewhere to point.",
      "speaker": "Fraser"
    },
    "bc1e04b7": {
      "file": "wallace-bc1e04b7.m4a",
      "ms": 1574,
      "text": "No, not you as well.",
      "speaker": "Wallace"
    },
    "bc2ea464": {
      "file": "graham-bc2ea464.m4a",
      "ms": 3940,
      "text": "For every one we cut down, Edward has five more fed and rested.",
      "speaker": "Graham"
    },
    "c0f957ff": {
      "file": "wallace-c0f957ff.m4a",
      "ms": 694,
      "text": "Finish it!",
      "speaker": "Wallace"
    },
    "c312f903": {
      "file": "narrator-c312f903.m4a",
      "ms": 1942,
      "text": "Horses die on spearpoints",
      "speaker": "Narrator"
    },
    "c4bfefad": {
      "file": "wallace-c4bfefad.m4a",
      "ms": 1619,
      "text": "Hop gracefully if you can.",
      "speaker": "Wallace"
    },
    "c50913d3": {
      "file": "moray-c50913d3.m4a",
      "ms": 2949,
      "text": "Spears for their horses, javelins for their bowmen.",
      "speaker": "Moray"
    },
    "c5176c7a": {
      "file": "narrator-c5176c7a.m4a",
      "ms": 3055,
      "text": "Lanarkshire, May 1297.",
      "speaker": "Narrator"
    },
    "c5810312": {
      "file": "narrator-c5810312.m4a",
      "ms": 3056,
      "text": "A Market turns spare grain and timber into coin.",
      "speaker": "Narrator"
    },
    "c6cf6961": {
      "file": "graham-c6cf6961.m4a",
      "ms": 1727,
      "text": "The men eat English bread tonight.",
      "speaker": "Graham"
    },
    "c73c0b96": {
      "file": "graham-c73c0b96.m4a",
      "ms": 3156,
      "text": "First the pride of England breaks itself on our spears.",
      "speaker": "Graham"
    },
    "c7ae8e4f": {
      "file": "graham-c7ae8e4f.m4a",
      "ms": 2069,
      "text": "wagons want gold more than grain.",
      "speaker": "Graham"
    },
    "c84e3a1b": {
      "file": "narrator-c84e3a1b.m4a",
      "ms": 3409,
      "text": "Tap a villager, then tap berries or a sheep to gather.",
      "speaker": "Narrator"
    },
    "c86b1cda": {
      "file": "narrator-c86b1cda.m4a",
      "ms": 4484,
      "text": "Edward's engineers bring up rams and stone-throwers against the camp walls.",
      "speaker": "Narrator"
    },
    "c8fe7e67": {
      "file": "wallace-c8fe7e67.m4a",
      "ms": 1892,
      "text": "Scotland is not finished with you!",
      "speaker": "Wallace"
    },
    "c9910b42": {
      "file": "narrator-c9910b42.m4a",
      "ms": 2912,
      "text": "Earnside, September 1304.",
      "speaker": "Narrator"
    },
    "c9be2ae1": {
      "file": "narrator-c9be2ae1.m4a",
      "ms": 6341,
      "text": "In England, Edward puts aside his French war and turns north with the greatest army he has ever raised.",
      "speaker": "Narrator"
    },
    "cb51f1b0": {
      "file": "douglas-cb51f1b0.m4a",
      "ms": 1222,
      "text": "Simple arithmetic.",
      "speaker": "Douglas"
    },
    "cb54ffe3": {
      "file": "douglas-cb54ffe3.m4a",
      "ms": 2371,
      "text": "Now let us give Ormesby reason to fear it.",
      "speaker": "Douglas"
    },
    "cba05c82": {
      "file": "wallace-cba05c82.m4a",
      "ms": 769,
      "text": "Good timber.",
      "speaker": "Wallace"
    },
    "cc6c8b05": {
      "file": "graham-cc6c8b05.m4a",
      "ms": 999,
      "text": "The line is ready.",
      "speaker": "Graham"
    },
    "ce28c449": {
      "file": "wallace-ce28c449.m4a",
      "ms": 2047,
      "text": "and more hands to swing the axes.",
      "speaker": "Wallace"
    },
    "cf3ca005": {
      "file": "narrator-cf3ca005.m4a",
      "ms": 3160,
      "text": "Robert Bruce takes the crown in 1306;",
      "speaker": "Narrator"
    },
    "d0613367": {
      "file": "graham-d0613367.m4a",
      "ms": 2542,
      "text": "The schiltrons will hold the horses, Will.",
      "speaker": "Graham"
    },
    "d0dcbed1": {
      "file": "wallace-d0dcbed1.m4a",
      "ms": 862,
      "text": "Up the path",
      "speaker": "Wallace"
    },
    "d2012006": {
      "file": "wallace-d2012006.m4a",
      "ms": 1472,
      "text": "first we feed our own.",
      "speaker": "Wallace"
    },
    "d208da90": {
      "file": "narrator-d208da90.m4a",
      "ms": 1808,
      "text": "The English position breaks.",
      "speaker": "Narrator"
    },
    "d328c242": {
      "file": "graham-d328c242.m4a",
      "ms": 1269,
      "text": "It's the bowmen I fear",
      "speaker": "Graham"
    },
    "d379bb4e": {
      "file": "narrator-d379bb4e.m4a",
      "ms": 4323,
      "text": "Falkirk, 22 July 1298.",
      "speaker": "Narrator"
    },
    "d3fd659b": {
      "file": "graham-d3fd659b.m4a",
      "ms": 4136,
      "text": "Mangonels forward, and every rider we have on their flanks, NOW!",
      "speaker": "Graham"
    },
    "d419416f": {
      "file": "graham-d419416f.m4a",
      "ms": 836,
      "text": "Then Hexham",
      "speaker": "Graham"
    },
    "d656a043": {
      "file": "graham-d656a043.m4a",
      "ms": 1838,
      "text": "A counting-house in a war camp.",
      "speaker": "Graham"
    },
    "d6aab0ca": {
      "file": "fraser-d6aab0ca.m4a",
      "ms": 1252,
      "text": "taken in the sweeps.",
      "speaker": "Fraser"
    },
    "d78a96aa": {
      "file": "graham-d78a96aa.m4a",
      "ms": 1035,
      "text": "Corbridge first.",
      "speaker": "Graham"
    },
    "d87e459d": {
      "file": "wallace-d87e459d.m4a",
      "ms": 282,
      "text": "Aye",
      "speaker": "Wallace"
    },
    "d9dedf07": {
      "file": "narrator-d9dedf07.m4a",
      "ms": 5446,
      "text": "But Edward's great host, starving and mutinous, cannot hold what it has won.",
      "speaker": "Narrator"
    },
    "db8ed3ff": {
      "file": "wallace-db8ed3ff.m4a",
      "ms": 1756,
      "text": "Remember this hour, lads",
      "speaker": "Wallace"
    },
    "dcb3e2b4": {
      "file": "narrator-dcb3e2b4.m4a",
      "ms": 1877,
      "text": "The Forest says otherwise.",
      "speaker": "Narrator"
    },
    "ddb5794b": {
      "file": "graham-ddb5794b.m4a",
      "ms": 2278,
      "text": "Ryton's granary, in our wagons.",
      "speaker": "Graham"
    },
    "de553f98": {
      "file": "wallace-de553f98.m4a",
      "ms": 999,
      "text": "The line is ready.",
      "speaker": "Wallace"
    },
    "dffb6dc6": {
      "file": "warenne-dffb6dc6.m4a",
      "ms": 908,
      "text": "Burn the bridge.",
      "speaker": "Warenne"
    },
    "e072b98f": {
      "file": "wallace-e072b98f.m4a",
      "ms": 1278,
      "text": "Scotland's nobles.",
      "speaker": "Wallace"
    },
    "e0a5fab6": {
      "file": "moray-e0a5fab6.m4a",
      "ms": 1082,
      "text": "Let them cross.",
      "speaker": "Moray"
    },
    "e1a33339": {
      "file": "douglas-e1a33339.m4a",
      "ms": 1661,
      "text": "Steel buys back Scotland.",
      "speaker": "Douglas"
    },
    "e1fdf644": {
      "file": "wallace-e1fdf644.m4a",
      "ms": 1547,
      "text": "You hear me, Andrew",
      "speaker": "Wallace"
    },
    "e557e857": {
      "file": "wallace-e557e857.m4a",
      "ms": 1942,
      "text": "Now we let the river do the counting.",
      "speaker": "Wallace"
    },
    "e800c3cc": {
      "file": "moray-e800c3cc.m4a",
      "ms": 3102,
      "text": "We need ten and eight before Cressingham loses patience.",
      "speaker": "Moray"
    },
    "e91a0a11": {
      "file": "narrator-e91a0a11.m4a",
      "ms": 2725,
      "text": "he could not betray a king who was never his.",
      "speaker": "Narrator"
    },
    "ea08dcce": {
      "file": "douglas-ea08dcce.m4a",
      "ms": 1117,
      "text": "Gold buys steel.",
      "speaker": "Douglas"
    },
    "ed86934e": {
      "file": "narrator-ed86934e.m4a",
      "ms": 3104,
      "text": "Comyn's banners are already small on the northern road.",
      "speaker": "Narrator"
    },
    "ee2276a2": {
      "file": "narrator-ee2276a2.m4a",
      "ms": 2574,
      "text": "the treasurer pays his own arrears at last.",
      "speaker": "Narrator"
    },
    "ee756cfc": {
      "file": "narrator-ee756cfc.m4a",
      "ms": 4019,
      "text": "A third of the army lies on the moor, and Sir John de Graham with them.",
      "speaker": "Narrator"
    },
    "efcdbd94": {
      "file": "fraser-efcdbd94.m4a",
      "ms": 4166,
      "text": "Earnside’s bridge and Bothwell’s walls are all that stand between us and the Warden.",
      "speaker": "Fraser"
    },
    "f305b6a9": {
      "file": "wallace-f305b6a9.m4a",
      "ms": 801,
      "text": "There's work.",
      "speaker": "Wallace"
    },
    "f30b6704": {
      "file": "narrator-f30b6704.m4a",
      "ms": 1938,
      "text": "There is no more room to be clever.",
      "speaker": "Narrator"
    },
    "f4c05c18": {
      "file": "moray-f4c05c18.m4a",
      "ms": 973,
      "text": "Take the bridgehead",
      "speaker": "Moray"
    },
    "f553e6a5": {
      "file": "narrator-f553e6a5.m4a",
      "ms": 4019,
      "text": "Northumberland, winter 1297.",
      "speaker": "Narrator"
    },
    "f6131cc6": {
      "file": "narrator-f6131cc6.m4a",
      "ms": 2344,
      "text": "the commoner now first man of the kingdom.",
      "speaker": "Narrator"
    },
    "f74509f3": {
      "file": "graham-f74509f3.m4a",
      "ms": 920,
      "text": "Lock and hold!",
      "speaker": "Graham"
    },
    "fab98f3e": {
      "file": "fraser-fab98f3e.m4a",
      "ms": 1617,
      "text": "Add it to the Warden's account.",
      "speaker": "Fraser"
    },
    "fbc3eb97": {
      "file": "narrator-fbc3eb97.m4a",
      "ms": 2359,
      "text": "Edward’s drums answer across the moor.",
      "speaker": "Narrator"
    },
    "fbc97f74": {
      "file": "douglas-fbc97f74.m4a",
      "ms": 1857,
      "text": "His patrol is already on the road.",
      "speaker": "Douglas"
    },
    "fcfbb2df": {
      "file": "wallace-fcfbb2df.m4a",
      "ms": 3353,
      "text": "This day is ash in my mouth, whatever else it brings.",
      "speaker": "Wallace"
    },
    "fe3416ce": {
      "file": "narrator-fe3416ce.m4a",
      "ms": 1975,
      "text": "One garrison left on the Tyne",
      "speaker": "Narrator"
    },
    "fe525f1e": {
      "file": "narrator-fe525f1e.m4a",
      "ms": 9975,
      "text": "On 5 August 1305, at Robroyston near Glasgow, Wallace is captured by men serving Sir John Menteith and carried south in chains.",
      "speaker": "Narrator"
    },
    "ff2e9da9": {
      "file": "wallace-ff2e9da9.m4a",
      "ms": 1117,
      "text": "remember who stayed.",
      "speaker": "Wallace"
    }
  }
}
